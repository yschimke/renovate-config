{
  "owner": "yschimke",
  "repo_settings": {
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "BLANK",
    "allow_auto_merge": true,
    "delete_branch_on_merge": true,
    "allow_update_branch": true
  },
  "actions_workflow_permissions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": true
  },
  "ruleset": {
    "name": "Protect Main",
    "admin_bypass_mode": "always",
    "strict_required_status_checks_policy": false
  },
  "common_required_checks": [
    {
      "check": "Conventional Commit title",
      "workflow": "pr-title.yml"
    },
    {
      "check": "Reject agent attribution",
      "workflow": "no-agent-attribution.yml"
    }
  ],
  "repos": {
    "compose-ai-tools": [
      "Plugin Unit Tests",
      "Module Unit Tests",
      "Plugin Functional Tests",
      "Build CLI"
    ],
    "compose-preview-contracts": [
      "Check"
    ],
    "compose-preview-daemon": [
      "Module Unit Tests",
      "Daemon Android Tests",
      "Sidecar archives"
    ],
    "compose-preview-server": [
      "gradle"
    ],
    "compose-preview-vscode": [
      "Build and test"
    ],
    "compose-preview-ide": [
      "plugin"
    ],
    "compose-preview-xr": [
      "build (linux-x86_64)",
      "build (macos-arm64)",
      "build (windows-x86_64)",
      "renderer-xr (Android/Robolectric)"
    ],
    "compose-preview-imports": [],
    "compose-ui-builder": [
      "gradle"
    ],
    "m3-catalog": [
      "Build + discover previews",
      "Unit tests"
    ],
    "wear-m3-catalog": [
      "Build + discover previews",
      "Unit tests"
    ],
    "remote-m3-catalog": [
      "Build + discover previews",
      "Unit tests"
    ],
    "glimmer-catalog": [
      "android-catalogs"
    ],
    "a2ui-catalog": [
      "Build + discover previews",
      "Unit tests",
      "A2UI CMP port",
      "UI-builder renderer runtime"
    ],
    "flexpress": [
      "build"
    ],
    "skills": [
      "Validate manifests and skills"
    ],
    "compose-agent-plugins": [
      "validate"
    ]
  },
  "branch_rulesets": {
    "wear-m3-catalog": [
      {
        "branch": "wear-compose-cmp",
        "checks": [
          "build"
        ]
      }
    ]
  },
  "long_lived_branches": {
    "ruleset_name": "Protect long-lived branches",
    "repos": {
      "wear-m3-catalog": {
        "include": [
          "wear-compose-cmp"
        ]
      },
      "compose-preview-vscode": {
        "include": [
          "preview/main",
          "preview/pr"
        ]
      },
      "compose-ui-builder": {
        "include": [
          "compose-preview/main",
          "compose-preview/pr",
          "ui-builder-designs/main",
          "ui-builder-designs/wear-m3"
        ]
      },
      "flexpress": {
        "include": [
          "compose-preview/main",
          "compose-preview/pr"
        ]
      },
      "a2ui-catalog-out": {
        "include": [
          "~ALL"
        ],
        "exclude": [
          "refs/heads/agent/**/*"
        ]
      },
      "glimmer-catalog-out": {
        "include": [
          "~ALL"
        ],
        "exclude": [
          "refs/heads/agent/**/*"
        ]
      },
      "m3-catalog-out": {
        "include": [
          "~ALL"
        ],
        "exclude": [
          "refs/heads/agent/**/*"
        ]
      },
      "remote-m3-catalog-out": {
        "include": [
          "~ALL"
        ],
        "exclude": [
          "refs/heads/agent/**/*"
        ]
      },
      "wear-m3-catalog-out": {
        "include": [
          "~ALL"
        ],
        "exclude": [
          "refs/heads/agent/**/*"
        ]
      },
      "compose-preview-imports-out": {
        "include": [
          "~ALL"
        ],
        "exclude": [
          "refs/heads/agent/**/*"
        ]
      }
    }
  }
}
